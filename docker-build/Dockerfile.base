FROM ubuntu:24.04

ARG TARGETPLATFORM
ARG FFMPEG_VERSION=9.0

# install deps
RUN apt-get update && \
    apt-get install -y curl wget gnupg unzip fonts-noto pulseaudio xz-utils ca-certificates xvfb rsync \
    fonts-noto-cjk fonts-liberation fontconfig fonts-dejavu fonts-dejavu-extra

# install chrome using livekit/chrome-installer
COPY --from=livekit/chrome-installer:146.0.7680.177-1 /chrome-installer /chrome-installer
RUN /chrome-installer/install-chrome "$TARGETPLATFORM"

RUN set -eux; \
    case "${TARGETPLATFORM:-linux64}" in \
        linux/amd64|linux64) FFMPEG_ARCH="linux64" ;; \
        linux/arm64|linuxarm64) FFMPEG_ARCH="linuxarm64" ;; \
        *) echo "unsupported TARGETPLATFORM '${TARGETPLATFORM}' (expected linux/amd64 or linux/arm64)" >&2; exit 1 ;; \
    esac; \
    FFMPEG_TARBALL="ffmpeg-n${FFMPEG_VERSION}-latest-${FFMPEG_ARCH}-gpl-${FFMPEG_VERSION}.tar.xz"; \
    curl -fsSL -o "/tmp/${FFMPEG_TARBALL}" "https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/${FFMPEG_TARBALL}"; \
    mkdir /tmp/ffmpeg-build; \
    tar -xJf "/tmp/${FFMPEG_TARBALL}" -C /tmp/ffmpeg-build; \
    mv /tmp/ffmpeg-build/*/bin/ff* /usr/local/bin/; \
    chmod +x /usr/local/bin/ff*; \
    rm -rf "/tmp/${FFMPEG_TARBALL}" /tmp/ffmpeg-build; \
    ffmpeg -version;

# clean up
RUN apt-get clean && rm -rf /var/lib/apt/lists/*
